<Window x:Class="BotSpeaker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot Speaker Settings"
        Width="560" Height="560"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="ElevenLabs" FontSize="15" FontWeight="Bold"/>
            <PasswordBox x:Name="KeyBox" Margin="0,8,0,4" Padding="4"/>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="SaveKeyButton" Content="Save Key" Padding="10,4" Click="OnSaveKeyClick"/>
                    <TextBlock x:Name="KeySavedLabel" Text="🛡 Saved (DPAPI encrypted)" Foreground="Gray"
                               VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Button x:Name="RemoveKeyButton" Content="Remove" Padding="10,4" HorizontalAlignment="Right"
                        Foreground="Red" Visibility="Collapsed" Click="OnRemoveKeyClick"/>
            </DockPanel>

            <DockPanel Margin="0,14,0,0">
                <TextBlock Text="Voice" Width="110" VerticalAlignment="Center"/>
                <Button x:Name="RefreshVoicesButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="⟳" FontSize="14" ToolTip="Refresh ElevenLabs voices" Click="OnRefreshVoicesClick"/>
                <ComboBox x:Name="VoiceCombo" SelectionChanged="OnVoiceSelected"/>
            </DockPanel>
            <TextBlock x:Name="VoiceError" FontSize="11" Foreground="DarkOrange" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="110,4,0,0"/>

            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Voice ID" Width="110" VerticalAlignment="Center"/>
                <TextBox x:Name="VoiceIdBox" Padding="3" LostFocus="OnVoiceIdChanged"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Model ID" Width="110" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelIdBox" Padding="3" LostFocus="OnModelIdChanged"/>
            </DockPanel>

            <Separator Margin="0,16,0,12"/>
            <TextBlock Text="Audio routing" FontSize="15" FontWeight="Bold"/>

            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Output device" Width="110" VerticalAlignment="Center"/>
                <ComboBox x:Name="OutputCombo" SelectionChanged="OnOutputSelected"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Interruption input" Width="110" VerticalAlignment="Center"/>
                <ComboBox x:Name="InputCombo" SelectionChanged="OnInputSelected"/>
            </DockPanel>

            <DockPanel Margin="0,10,0,0">
                <Button Content="Refresh Devices" Padding="10,4" Click="OnRefreshDevicesClick"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OnLinkNavigate">Install VB-CABLE…</Hyperlink>
                </TextBlock>
            </DockPanel>

            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Select the cable's playback device (CABLE Input) above, then in Zoom, Meet, or Teams choose CABLE Output as your microphone."/>
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Interruption detection learns the ambient level, pauses immediately after 0.4 seconds of elevated input, and resumes after 0.75 seconds back at ambient. Direct cable output or headphones prevent Bot Speaker from detecting its own voice."/>
            <TextBlock x:Name="InterruptionError" FontSize="11" Foreground="DarkOrange" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <TextBlock x:Name="Feedback" FontSize="11" Foreground="Gray" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Window>
