<Window x:Class="BotSpeaker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot Speaker Settings"
        Icon="Assets/BotSpeaker.png"
        Width="560" Height="560"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="ElevenLabs" FontSize="15" FontWeight="Bold"/>
            <DockPanel Margin="0,10,0,0">
                <TextBlock x:Name="KeyStatusLabel" Text="🔑 API key not configured" Foreground="Gray"
                           VerticalAlignment="Center"/>
                <Button x:Name="EditKeyButton" Content="Add API Key…" Padding="10,4" HorizontalAlignment="Right"
                        Click="OnEditKeyClick"/>
            </DockPanel>
            <Popup x:Name="KeyPopup" PlacementTarget="{Binding ElementName=EditKeyButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" Opened="OnKeyPopupOpened">
                <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="#60808080" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4,8,8"
                        Width="380">
                    <StackPanel>
                        <TextBlock x:Name="KeyPopupHeading" Text="Add ElevenLabs API Key" FontWeight="Bold"/>
                        <TextBlock Text="The key is validated with ElevenLabs, then stored encrypted with Windows DPAPI for your user account."
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,10"/>
                        <PasswordBox x:Name="KeyBox" Padding="4"/>
                        <TextBlock x:Name="KeyPopupError" FontSize="11" Foreground="Red" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="RemoveKeyButton" Content="Remove Key" Padding="10,4" Foreground="Red"
                                    Visibility="Collapsed" Click="OnRemoveKeyClick"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Padding="10,4" Click="OnKeyPopupCancel"/>
                                <Button x:Name="SaveKeyButton" Content="Save Key" Padding="10,4" Margin="8,0,0,0"
                                        FontWeight="Bold" Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                        Click="OnSaveKeyClick"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <DockPanel Margin="0,14,0,0">
                <TextBlock Text="Voice ID" Width="110" VerticalAlignment="Center"/>
                <TextBox x:Name="VoiceIdBox" Padding="3" LostFocus="OnVoiceIdChanged"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Model ID" Width="110" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelIdBox" Padding="3" LostFocus="OnModelIdChanged"/>
            </DockPanel>

            <Separator Margin="0,16,0,12"/>
            <TextBlock Text="Audio routing" FontSize="15" FontWeight="Bold"/>

            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Output device" Width="110" VerticalAlignment="Center"/>
                <ComboBox x:Name="OutputCombo" SelectionChanged="OnOutputSelected"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Interruption input" Width="110" VerticalAlignment="Center"/>
                <ComboBox x:Name="InputCombo" SelectionChanged="OnInputSelected"/>
            </DockPanel>

            <DockPanel Margin="0,10,0,0">
                <Button Content="Refresh Devices" Padding="10,4" Click="OnRefreshDevicesClick"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OnLinkNavigate">Install VB-CABLE…</Hyperlink>
                </TextBlock>
            </DockPanel>

            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Select the cable's playback device (CABLE Input) above, then in Zoom, Meet, or Teams choose CABLE Output as your microphone."/>
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Interruption detection learns the ambient level, pauses immediately after 0.4 seconds of elevated input, and resumes after 0.75 seconds back at ambient. Direct cable output or headphones prevent Bot Speaker from detecting its own voice."/>
            <TextBlock x:Name="InterruptionError" FontSize="11" Foreground="DarkOrange" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <TextBlock x:Name="Feedback" FontSize="11" Foreground="Gray" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Window>
