<UserControl x:Class="BotSpeaker.OrchestrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header: matches the meeting configuration page it replaces in place -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border x:Name="StatusPill" DockPanel.Dock="Right" Background="#22808080" CornerRadius="11"
                    Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="StatusPillText" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="⚙" FontSize="16" Margin="0,0,8,0" ToolTip="Settings" Click="OnSettingsClick"/>
            <TextBlock Text="👥 Orchestrated Meeting" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Grid>
            <!-- Active host session -->
            <DockPanel x:Name="HostPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Background="#0D808080" CornerRadius="9" Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Orchestrated meeting" FontWeight="Bold"/>
                            <TextBlock x:Name="PlanStateText" Text="Draft" DockPanel.Dock="Right"
                                       FontSize="11" Foreground="Gray"/>
                        </DockPanel>
                        <TextBlock x:Name="SpeakerMappingText"
                                   FontSize="11" Foreground="Gray" Margin="0,0,0,6"/>
                        <RichTextBox x:Name="MeetingScriptBox" IsReadOnly="True" IsDocumentEnabled="True"
                                     VerticalScrollBarVisibility="Auto" Height="110" Padding="6"
                                     BorderBrush="#40808080" BorderThickness="1"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Rectangle Width="12" Height="8" Fill="#5934C759" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Spoken" FontSize="11" Foreground="Gray" Margin="4,0,12,0"
                                       VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="8" Fill="#8C2E6BD6" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Speaking" FontSize="11" Foreground="Gray" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error + controls -->
                <TextBlock x:Name="HostErrorText" DockPanel.Dock="Bottom" FontSize="11" Foreground="Red"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="LeaveButton" Content="Leave" Padding="10,5" Click="OnLeaveClick"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ExportButton" Content="Export Timestamped JSON…" Padding="10,5"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="OnExportClick"/>
                        <Button x:Name="SkipButton" Content="Skip Turn" Padding="10,5" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="OnSkipClick"/>
                        <Button x:Name="PauseButton" Content="⏸ Pause" Padding="10,5" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="OnPauseClick"/>
                        <Button x:Name="ResumeButton" Content="▶ Play" Padding="10,5" Margin="0,0,8,0"
                                FontWeight="Bold" Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnResumeClick"/>
                        <Button x:Name="StopButton" Content="Stop" Padding="10,5" Margin="0,0,8,0"
                                Foreground="DarkRed" Visibility="Collapsed" Click="OnStopClick"/>
                        <Button x:Name="StartButton" Content="▶ Start Meeting" Padding="14,5" FontWeight="Bold"
                                Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnStartClick"/>
                        <Button x:Name="PrepareButton" Content="Prepare Speakers" Padding="14,5" FontWeight="Bold"
                                Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnPrepareClick"/>
                        <Button x:Name="DoneButton" Content="Choose Another Script" Padding="14,5" FontWeight="Bold"
                                Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnChooseAnotherScriptClick"/>
                    </StackPanel>
                </DockPanel>

                <!-- Speakers and timeline -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Speakers" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SpeakersList"/>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Turn timeline" Padding="4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="NowSpeakingText" FontWeight="Bold" Visibility="Collapsed"/>
                                <TextBlock x:Name="NowSpeakingDetail" FontSize="11" Foreground="Gray"
                                           Visibility="Collapsed" Margin="0,0,0,6"/>
                                <ProgressBar x:Name="TurnProgress" Height="8" Margin="0,0,0,8"
                                             Visibility="Collapsed"/>
                                <TextBlock x:Name="TimelineEmptyText" FontSize="12" Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Text="Pair speakers, arrange them, then start the meeting."/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TimelineList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </DockPanel>

            <!-- Active remote session -->
            <DockPanel x:Name="RemotePanel" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Bottom">
                    <Button Content="Disconnect" DockPanel.Dock="Right" Padding="10,5" Click="OnLeaveClick"/>
                    <TextBlock Text="Script playback controls are locked while this PC is paired."
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="RemoteStatusIcon" Text="⏳" FontSize="52" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RemoteStatusTitle" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock x:Name="RemoteStatusDetail" Foreground="Gray" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                    <Border Background="#14808080" CornerRadius="9" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Room" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteRoomText" FontSize="12" FontFamily="Consolas"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Speaker" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteSpeakerText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Script" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteScriptText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Voice" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteVoiceText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Prepared paragraphs" Width="130" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteTurnsText" FontSize="12"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RemoteCurrentTurnText" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="RemoteErrorText" FontSize="12" Foreground="Red" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <!-- Ad hoc speech on this attendee, between scripted turns -->
                    <GroupBox Header="🎙 Speak on this PC" Padding="10" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ad hoc text plays through this PC's output between scripted turns. Text the host sends here shows up below too."
                                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ContentControl x:Name="RemoteSpeakHost"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
