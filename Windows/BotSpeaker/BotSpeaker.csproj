<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BotSpeaker</RootNamespace>
    <AssemblyName>BotSpeaker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BotSpeaker.ico</ApplicationIcon>
    <Version>0.6.0</Version>
    <StartupObject>BotSpeaker.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the WinForms implicit usings out of a primarily-WPF codebase. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Examples\launch-retro-product-manager.txt" />
    <EmbeddedResource Include="Examples\launch-retro-engineering-lead.txt" />
    <EmbeddedResource Include="Examples\launch-retro-support-lead.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon survives single-file publish (no loose Assets dir). -->
    <EmbeddedResource Include="Assets\BotSpeaker.ico" />
    <Resource Include="Assets\BotSpeaker.png" />
    <Resource Include="Assets\Recall.png" />
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="recall-silence.mp3" LogicalName="BotSpeaker.recall-silence.mp3" /></ItemGroup>
</Project>
