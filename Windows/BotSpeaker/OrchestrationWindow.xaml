<Window x:Class="BotSpeaker.OrchestrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Orchestrator"
        Icon="Assets/BotSpeaker.png"
        Width="820" Height="680"
        MinWidth="720" MinHeight="620">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="#40808080" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border x:Name="StatusPill" DockPanel.Dock="Right" Background="#22808080" CornerRadius="11"
                        Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StatusPillText" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Meeting Orchestrator" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Pair laptops, alternate speakers automatically, and export exact timestamps."
                                   FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20">
            <!-- Setup -->
            <DockPanel x:Name="SetupPanel">
                <StackPanel DockPanel.Dock="Top">
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <RadioButton x:Name="HostModeRadio" Content="Host" GroupName="Mode" IsChecked="True"
                                     Style="{StaticResource {x:Type ToggleButton}}" Padding="0,6"
                                     Checked="OnModeChanged"/>
                        <RadioButton x:Name="RemoteModeRadio" Content="Remote Client" GroupName="Mode"
                                     Style="{StaticResource {x:Type ToggleButton}}" Padding="0,6"
                                     Checked="OnModeChanged"/>
                    </UniformGrid>

                    <Border Background="#14808080" CornerRadius="9" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="💻 This PC" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Device name" Width="100" FontSize="12" Foreground="Gray"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="SpeakerNameBox" Padding="3" TextChanged="OnSpeakerNameChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Script" Width="100" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="SetupScriptText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Turns" Width="100" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="SetupTurnsText" FontSize="12"/>
                            </DockPanel>
                            <TextBlock x:Name="SetupScriptWarning" FontSize="11" Foreground="DarkOrange"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                                       Text="⚠ Choose or replicate a playable script in the main window first."/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="PairingEntryPanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock Text="Pairing code" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="PairingCodeBox" FontSize="20" FontFamily="Consolas" Padding="6"
                                 CharacterCasing="Upper" MaxLength="6" TextChanged="OnPairingCodeChanged"
                                 KeyDown="OnPairingCodeKeyDown"/>
                        <TextBlock Text="Enter the six-character code shown on the host machine."
                                   FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="SetupErrorText" FontSize="12" Foreground="Red" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Host Meeting"
                            Padding="14,6" FontWeight="Bold" MinWidth="140"
                            Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                            Click="OnConnectClick"/>
                    <TextBlock Text="Cloud coordination: Firebase project bot-speaker-1"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid/>
            </DockPanel>

            <!-- Active host session -->
            <DockPanel x:Name="HostPanel" Visibility="Collapsed">
                <!-- Pairing card -->
                <Border DockPanel.Dock="Top" Background="#14808080" CornerRadius="9" Padding="14"
                        Margin="0,0,0,12">
                    <DockPanel>
                        <CheckBox x:Name="AllowPairingCheck" DockPanel.Dock="Right" Content="Allow pairing"
                                  VerticalAlignment="Center" Click="OnAllowPairingChanged"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Pairing code" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="PairingCodeText" FontSize="30" FontWeight="Bold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                            <Button Content="📋" FontSize="14" Padding="8,4" Margin="12,0,0,0"
                                    VerticalAlignment="Center" ToolTip="Copy pairing code"
                                    Click="OnCopyPairingCodeClick"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="#0D808080" CornerRadius="9" Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Orchestrated meeting" FontWeight="Bold"/>
                            <TextBlock x:Name="PlanStateText" Text="Draft" DockPanel.Dock="Right"
                                       FontSize="11" Foreground="Gray"/>
                        </DockPanel>
                        <TextBlock x:Name="SpeakerMappingText"
                                   FontSize="11" Foreground="Gray" Margin="0,0,0,6"/>
                        <TextBox x:Name="MeetingScriptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="110" Padding="6"
                                 TextChanged="OnMeetingScriptChanged"/>
                    </StackPanel>
                </Border>

                <!-- Error + controls -->
                <TextBlock x:Name="HostErrorText" DockPanel.Dock="Bottom" FontSize="11" Foreground="Red"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="LeaveButton" Content="Leave" Padding="10,5" Click="OnLeaveClick"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ExportButton" Content="Export Timestamped JSON…" Padding="10,5"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="OnExportClick"/>
                        <Button x:Name="SkipButton" Content="Skip Turn" Padding="10,5" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="OnSkipClick"/>
                        <Button x:Name="PauseButton" Content="Pause" Padding="10,5" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="OnPauseClick"/>
                        <Button x:Name="ResumeButton" Content="Resume" Padding="10,5" Margin="0,0,8,0"
                                FontWeight="Bold" Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnResumeClick"/>
                        <Button x:Name="StopButton" Content="Stop" Padding="10,5" Margin="0,0,8,0"
                                Foreground="DarkRed" Visibility="Collapsed" Click="OnStopClick"/>
                        <Button x:Name="StartButton" Content="▶ Start Meeting" Padding="14,5" FontWeight="Bold"
                                Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnStartClick"/>
                        <Button x:Name="PrepareButton" Content="Prepare Speakers" Padding="14,5" FontWeight="Bold"
                                Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnPrepareClick"/>
                        <Button x:Name="DoneButton" Content="Done" Padding="14,5" FontWeight="Bold"
                                Background="#FF2E6BD6" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed" Click="OnLeaveClick"/>
                    </StackPanel>
                </DockPanel>

                <!-- Speakers and timeline -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Speakers" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SpeakersList"/>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Turn timeline" Padding="4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="NowSpeakingText" FontWeight="Bold" Visibility="Collapsed"/>
                                <TextBlock x:Name="NowSpeakingDetail" FontSize="11" Foreground="Gray"
                                           Visibility="Collapsed" Margin="0,0,0,6"/>
                                <ProgressBar x:Name="TurnProgress" Height="8" Margin="0,0,0,8"
                                             Visibility="Collapsed"/>
                                <TextBlock x:Name="TimelineEmptyText" FontSize="12" Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Text="Pair speakers, arrange them, then start the meeting."/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TimelineList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </DockPanel>

            <!-- Active remote session -->
            <DockPanel x:Name="RemotePanel" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Bottom">
                    <Button Content="Disconnect" DockPanel.Dock="Right" Padding="10,5" Click="OnLeaveClick"/>
                    <TextBlock Text="Local playback controls are locked while this PC is paired."
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock x:Name="RemoteStatusIcon" Text="⏳" FontSize="52" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RemoteStatusTitle" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock x:Name="RemoteStatusDetail" Foreground="Gray" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                    <Border Background="#14808080" CornerRadius="9" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Room" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteRoomText" FontSize="12" FontFamily="Consolas"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Speaker" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteSpeakerText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Script" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteScriptText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Voice" Width="110" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteVoiceText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Prepared paragraphs" Width="130" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="RemoteTurnsText" FontSize="12"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RemoteCurrentTurnText" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="RemoteErrorText" FontSize="12" Foreground="Red" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
