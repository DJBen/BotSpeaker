# Copy this file to .env and fill in the values below.
# .env is ignored by Git. Never commit the completed file.

# App Store Connect API key details from Users and Access > Integrations.
ASC_KEY_ID=
ASC_ISSUER_ID=

# Base64-encoded contents of the AuthKey_<KEY_ID>.p8 file, on one line.
# Create this value on macOS with:
#   base64 -i /absolute/path/to/AuthKey_<KEY_ID>.p8 | tr -d '\n'
ASC_PRIVATE_KEY_BASE64=
